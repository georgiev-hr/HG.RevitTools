<Window x:Class="HG.RevitTools.Views.ParameterChecker.ParameterCheckerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lighting Fixture Parameter Checker"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding HeaderText}"
                   FontSize="16"
                   FontWeight="SemiBold"/>

        <StackPanel Grid.Row="2">

            <TextBlock Text="Parameter"
                       Margin="0,0,0,5"/>

            <ComboBox ItemsSource="{Binding Parameters}"
                      SelectedItem="{Binding SelectedParameter}"
                      DisplayMemberPath="Name"
                      MinHeight="28"/>

        </StackPanel>

        <StackPanel Grid.Row="4">

            <TextBlock Text="Expected value"
                       Margin="0,0,0,5"/>

            <ComboBox ItemsSource="{Binding ParameterValues}"
                      SelectedItem="{Binding SelectedValue}"
                      MinHeight="28"/>

        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="90"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Select Mismatches"
                    Width="140"
                    Height="30"
                    IsEnabled="{Binding CanCheckElements}"
                    Click="SelectMismatches_Click"/>

        </StackPanel>

    </Grid>
</Window>